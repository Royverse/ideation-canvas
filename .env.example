# Copy to .env and fill in what you need. .env is gitignored.
#
# Get a key at https://build.nvidia.com — it starts with "nvapi-".


# ── Your own key, for local development ──────────────────────────────────────
#
# Optional. Without it, the app asks for a key on first load and keeps it in
# browser storage. Set it to skip that step in local development.
#
# Note: Vite inlines VITE_* variables into the client bundle at build time.
# A key set here is readable by anyone who loads the deployed site, so use it
# for local development only, never for a public deployment.
VITE_NVIDIA_API_KEY=nvapi-your-key-here


# ── The shared trial key, for the "try it now" button ────────────────────────
#
# Powers the trial: visitors call /api/trial/*, and netlify/functions/trial.mjs
# attaches this key server-side. No VITE_ prefix, so Vite never inlines it and
# it never reaches the browser.
#
# In production this belongs in the Netlify environment, not in a file:
#   npx netlify env:set NVIDIA_TRIAL_API_KEY "nvapi-…"
#
# Leave it unset and the trial button reports that the trial is switched off;
# the own-key path is unaffected. Whatever key you put here is spending your
# quota on strangers, so prefer a key you can rotate and watch.
NVIDIA_TRIAL_API_KEY=
